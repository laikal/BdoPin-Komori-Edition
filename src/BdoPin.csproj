<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
 <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"/>
 <PropertyGroup>
  <Configuration Condition="'$(Configuration)'==''">Release</Configuration><Platform Condition="'$(Platform)'==''">x64</Platform>
  <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget><Prefer32Bit>false</Prefer32Bit>
  <OutputType>WinExe</OutputType><AssemblyName>BdoPin</AssemblyName><LangVersion>7.3</LangVersion>
  <OutputPath>bin\x64\$(Configuration)\App\</OutputPath><Optimize>true</Optimize><Deterministic>true</Deterministic>
  <ApplicationIcon>Resources\BdoPin_MultiSize.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
 </PropertyGroup>
 <ItemGroup>
  <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/><Reference Include="System.Management"/>
  <Compile Include="Program.cs;UI\*.cs;Core\*.cs;Native\*.cs;Services\*.cs;Models\*.cs;Logging\*.cs;Localization\*.cs;Properties\*.cs"/>
  <EmbeddedResource Include="Resources\BdoPin_MultiSize.ico"><LogicalName>BdoPin.Icon</LogicalName></EmbeddedResource>
  <EmbeddedResource Include="Resources\eltax_profile.bmp"><LogicalName>BdoPin.Profile</LogicalName></EmbeddedResource>
  <EmbeddedResource Include="Resources\Default.ini"><LogicalName>BdoPin.Default.ini</LogicalName></EmbeddedResource>
  <EmbeddedResource Include="lang\en.lng"><LogicalName>BdoPin.English</LogicalName></EmbeddedResource>
  <Content Include="lang\*.lng"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  <Content Include="LICENSE"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  <None Include="App.config"/>
 </ItemGroup>
 <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
